{
  "manifest_version": 3,
  "name": "Vinted Bundle Creator",
  "version": "1.0",
  "description": "Exécute un script sur les pages Vinted",
  "permissions": ["scripting", "activeTab", "declarativeNetRequest", "storage"],
  "host_permissions": ["https://www.vinted.fr/*"],
  "action": {
    "default_popup": "popup.html"
  },
  "content_scripts": [
    {
      "js": ["content.js"],
      "matches": ["https://www.vinted.fr/items/*"]
    },
    {
      "js": ["content.js"],
      "matches": ["https://www.vinted.fr/member/*"],
      "exclude_matches": ["https://www.vinted.fr/member/*/bundles/*"]
    },
    {
      "js": ["addBundleItemsClick.js"],
      "matches": ["https://www.vinted.fr/member/*/bundles/*"]
    },
    {
      "js": ["hideAds.js"],
      "matches": ["https://www.vinted.fr/*"]
    }
  ],
  "web_accessible_resources": [
    {
      "resources": ["extPanel.html"],
      "matches": ["https://www.vinted.fr/*"]
    },
    {
      "resources": ["filterItemsList.html"],
      "matches": ["https://www.vinted.fr/*"]
    }
  ],
  "_comment1": "** To allow Vinted bundle to load all chosen items at once **",
  "_comment2": "\/ Use declarativeNetRequest permission to do it           \/",
  "background": {
    "service_worker": "background.js"
  }
}